# Copy to .env. Secrets are separate files, never this file or git.
PUBLIC_ORIGIN=https://skills.example.com
APP_DOMAIN=skills.example.com
# Set a reviewed image build commit. Never reuse this tag for different code.
RELEASE_SHA=replace-with-reviewed-commit
GITHUB_CLIENT_ID=replace-with-oauth-app-client-id
# Off is an explicit unavailable execution service; true requires both settings below.
EXECUTION_ENABLED=false
EXECUTION_MODEL=
# Secrets paths are resolved relative to compose.yaml. Files must exist.
SECRETS_DIR=./secrets
# Dedicated bridge subnet; choose a non-conflicting RFC1918 subnet on the target host.
APP_NETWORK_SUBNET=172.29.46.0/24
TRUSTED_PROXY_IP=172.29.46.2
