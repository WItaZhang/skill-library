{
  "name": "skill-library",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test:contracts": "node --experimental-strip-types --test contracts/*.test.ts",
    "test:service": "npm --prefix modules/service test",
    "test:runtime": "npm --prefix modules/runtime test",
    "test:web": "npm --prefix modules/web test",
    "test:broadcast": "npm --prefix modules/broadcast test",
    "test:publication": "node --experimental-strip-types --test acceptance/publication.test.ts",
    "test": "npm run test:contracts && npm run test:service && npm run test:runtime && npm run test:web && npm run test:broadcast && npm run test:publication",
    "install:production": "sh deployment/install.sh",
    "start:production": "node integration/production-start.ts",
    "check:production": "node deployment/validate-config.ts",
    "verify:release": "sh integration/verify-release.sh",
    "test:operations": "npm test --prefix modules/operations",
    "backup:drill": "node modules/operations/backup-drill.ts",
    "start:local": "node local/manage.ts open",
    "import:local": "node local/manage.ts import",
    "backup:local": "node local/manage.ts backup",
    "test:local": "node --test modules/local/*.test.ts"
  }
}
